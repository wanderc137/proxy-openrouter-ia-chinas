[86.687, "o", "\u001b[90m┌─ router.py · elegir y abrir el stream ────────────────────────────────────────────────────────────────\u001b[0m\n"]
[86.687, "o", "\u001b[90m  36\u001b[0m\u001b[90m │ \u001b[0m        available = \u001b[96mself\u001b[39;49;00m.pool.available_models()\u001b[90m\u001b[39;49;00m\n"]
[86.742, "o", "\u001b[90m  37\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m available:\u001b[90m\u001b[39;49;00m\n"]
[86.797, "o", "\u001b[90m  38\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mraise\u001b[39;49;00m RouterError(\u001b[33m\"\u001b[39;49;00m\u001b[33mNo hay ningún modelo gratuito disponible en este momento.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[86.852, "o", "\u001b[90m  39\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[86.907, "o", "\u001b[90m  40\u001b[0m\u001b[90m │ \u001b[0m        attempts: \u001b[96mlist\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m] = []\u001b[90m\u001b[39;49;00m\n"]
[86.962, "o", "\u001b[90m  41\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Prioridad: primero los modelos chinos, luego el resto. Dentro de cada\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[87.017, "o", "\u001b[90m  42\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# grupo, orden estable por nombre para un comportamiento predecible.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[87.072, "o", "\u001b[90m  43\u001b[0m\u001b[90m │ \u001b[0m        candidates = \u001b[96msorted\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[87.127, "o", "\u001b[90m  44\u001b[0m\u001b[90m │ \u001b[0m            available,\u001b[90m\u001b[39;49;00m\n"]
[87.182, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m            key=\u001b[94mlambda\u001b[39;49;00m m: (\u001b[95mnot\u001b[39;49;00m m.is_chinese, m.name.lower()),\u001b[90m\u001b[39;49;00m\n"]
[87.237, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[87.292, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[87.347, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m model \u001b[95min\u001b[39;49;00m candidates:\u001b[90m\u001b[39;49;00m\n"]
[87.402, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[87.457, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m                logger.info(\u001b[33m\"\u001b[39;49;00m\u001b[33mIntentando con modelo gratuito: \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, model.id)\u001b[90m\u001b[39;49;00m\n"]
[87.512, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m                stream = \u001b[96mself\u001b[39;49;00m.client.chat_stream(model.id, messages)\u001b[90m\u001b[39;49;00m\n"]
[87.567, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# Verificar que realmente arranca (evita modelos muertos)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[87.622, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m.pool.mark_success(model.id)\u001b[90m\u001b[39;49;00m\n"]
[87.677, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m._stream = model.id\u001b[90m\u001b[39;49;00m\n"]
[87.732, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mreturn\u001b[39;49;00m model.id, stream\u001b[90m\u001b[39;49;00m\n"]
