[61.835, "o", "\u001b[90m┌─ models_pool.py · is_chinese_model() ─────────────────────────────────────────────────────────────────\u001b[0m\n"]
[61.835, "o", "\u001b[90m  42\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mis_chinese_model\u001b[39;49;00m(model_id: \u001b[96mstr\u001b[39;49;00m, name: \u001b[96mstr\u001b[39;49;00m = \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) -> \u001b[96mbool\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[61.89, "o", "\u001b[90m  43\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Devuelve True si el modelo pertenece a un proveedor chino conocido.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[61.945, "o", "\u001b[90m  44\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mimport\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96mre\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[62.0, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m    haystack = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmodel_id\u001b[33m}\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mname\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.lower()\u001b[90m\u001b[39;49;00m\n"]
[62.055, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mfor\u001b[39;49;00m p \u001b[95min\u001b[39;49;00m CHINESE_PROVIDERS:\u001b[90m\u001b[39;49;00m\n"]
[62.11, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m p \u001b[95min\u001b[39;49;00m haystack:\u001b[90m\u001b[39;49;00m\n"]
[62.165, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[62.22, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m    low_name = name.lower()\u001b[90m\u001b[39;49;00m\n"]
[62.275, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mfor\u001b[39;49;00m kw \u001b[95min\u001b[39;49;00m CHINESE_KEYWORDS:\u001b[90m\u001b[39;49;00m\n"]
