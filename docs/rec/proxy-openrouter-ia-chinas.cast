[110.875, "o", "\u001b[90m┌─ server.py · GET /api/query ──────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[110.875, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m\u001b[37m@app\u001b[39;49;00m.get(\u001b[33m\"\u001b[39;49;00m\u001b[33m/api/query\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[110.93, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m\u001b[94masync\u001b[39;49;00m \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mquery\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[110.985, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m    q: \u001b[96mstr\u001b[39;49;00m = Query(..., min_length=\u001b[94m1\u001b[39;49;00m, max_length=\u001b[94m2000\u001b[39;49;00m, description=\u001b[33m\"\u001b[39;49;00m\u001b[33mPregunta\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[111.04, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m    key: \u001b[96mstr\u001b[39;49;00m = Query(\u001b[94mNone\u001b[39;49;00m, description=\u001b[33m\"\u001b[39;49;00m\u001b[33mAPI key de OpenRouter (usa .env si no viene)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[111.095, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m) -> JSONResponse:\u001b[90m\u001b[39;49;00m\n"]
[111.15, "o", "\u001b[90m  80\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Respuesta JSON compacta para microcontroladores (ESP8266) y scripts.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[111.205, "o", "\u001b[90m  81\u001b[0m\u001b[90m │ \u001b[0m    active_router = router\u001b[90m\u001b[39;49;00m\n"]
[111.26, "o", "\u001b[90m  82\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m key:\u001b[90m\u001b[39;49;00m\n"]
[111.315, "o", "\u001b[90m  83\u001b[0m\u001b[90m │ \u001b[0m        local_pool = ModelsPool(key)\u001b[90m\u001b[39;49;00m\n"]
[111.37, "o", "\u001b[90m  84\u001b[0m\u001b[90m │ \u001b[0m        local_client = OpenRouterClient(key)\u001b[90m\u001b[39;49;00m\n"]
[111.425, "o", "\u001b[90m  85\u001b[0m\u001b[90m │ \u001b[0m        active_router = FreeModelRouter(local_pool, local_client)\u001b[90m\u001b[39;49;00m\n"]
[111.48, "o", "\u001b[90m  86\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[111.535, "o", "\u001b[90m  87\u001b[0m\u001b[90m │ \u001b[0m    result = \u001b[94mawait\u001b[39;49;00m asyncio.to_thread(_query_sync, active_router, q)\u001b[90m\u001b[39;49;00m\n"]
[111.59, "o", "\u001b[90m  88\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m JSONResponse(result)\u001b[90m\u001b[39;49;00m\n"]
