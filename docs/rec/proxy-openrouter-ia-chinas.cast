[73.755, "o", "\u001b[90m  98\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mmark_failure\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, error: \u001b[96mstr\u001b[39;49;00m, status_code: \u001b[96mint\u001b[39;49;00m | \u001b[94mNone\u001b[39;49;00m = \u001b[94mNone\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
