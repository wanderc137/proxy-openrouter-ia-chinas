[122.68, "o", "\u001b[90m┌─ server.py · _query_sync() ───────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[122.68, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_query_sync\u001b[39;49;00m(rtr: FreeModelRouter, question: \u001b[96mstr\u001b[39;49;00m) -> \u001b[96mdict\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[122.735, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Ejecuta la consulta completa (síncrona) y devuelve un dict serializable.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[122.79, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m    messages = [{\u001b[33m\"\u001b[39;49;00m\u001b[33mrole\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33muser\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mcontent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: question}]\u001b[90m\u001b[39;49;00m\n"]
[122.845, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[122.9, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m        model_id, stream = rtr.stream(messages)\u001b[90m\u001b[39;49;00m\n"]
[122.955, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m        parts = []\u001b[90m\u001b[39;49;00m\n"]
[123.01, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m fragment \u001b[95min\u001b[39;49;00m stream:\u001b[90m\u001b[39;49;00m\n"]
[123.065, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m            parts.append(fragment)\u001b[90m\u001b[39;49;00m\n"]
[123.12, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m {\u001b[33m\"\u001b[39;49;00m\u001b[33mok\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94mTrue\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mmodel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: model_id, \u001b[33m\"\u001b[39;49;00m\u001b[33mtext\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join(parts), \u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94mNone\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[123.175, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m RouterError \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
[123.23, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m {\u001b[33m\"\u001b[39;49;00m\u001b[33mok\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94mFalse\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mmodel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94mNone\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mtext\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94mNone\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[96mstr\u001b[39;49;00m(exc)}\u001b[90m\u001b[39;49;00m\n"]
[123.285, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m \u001b[94mas\u001b[39;49;00m exc:  \u001b[90m# noqa: BLE001\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
