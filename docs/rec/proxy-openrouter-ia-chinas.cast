[73.15, "o", "\u001b[90m┌─ models_pool.py · disponibilidad y castigo ───────────────────────────────────────────────────────────\u001b[0m\n"]
[73.15, "o", "\u001b[90m  87\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mis_available\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, now: \u001b[96mfloat\u001b[39;49;00m) -> \u001b[96mbool\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[73.205, "o", "\u001b[90m  88\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.status == \u001b[33m\"\u001b[39;49;00m\u001b[33mbackoff\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m now < \u001b[96mself\u001b[39;49;00m.cooldown_until:\u001b[90m\u001b[39;49;00m\n"]
[73.26, "o", "\u001b[90m  89\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[73.315, "o", "\u001b[90m  90\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[73.37, "o", "\u001b[90m  91\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[73.425, "o", "\u001b[90m  92\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mmark_success\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
